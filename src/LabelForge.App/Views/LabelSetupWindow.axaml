<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelForge.App.ViewModels"
        x:Class="LabelForge.App.Views.LabelSetupWindow" x:DataType="vm:DesignerViewModel"
        Title="Label setup" Width="700" Height="620" WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="20">
        <ScrollViewer Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,12,0">
                <TextBlock Text="Media" FontSize="18" FontWeight="SemiBold" />
                <AutoCompleteBox x:Name="MediaBox" HorizontalAlignment="Stretch"
                                 PlaceholderText="Search by part number, material or size"
                                 ItemsSource="{Binding MediaCatalog}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 FilterMode="Custom"
                                 MinimumPrefixLength="2" />
                <Button Content="My media..."
                        ToolTip.Tip="Save the current label size as your own media, for stock the Zebra catalog does not list">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" Width="270">
                                <TextBlock Text="Save this size as my media" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding NewMediaSizeText}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="Name" FontSize="12" Opacity="0.8" />
                                <TextBox Text="{Binding NewMediaName}" PlaceholderText="Shipping 5 x 3 cm" />
                                <TextBlock Text="Material (optional)" FontSize="12" Opacity="0.8" />
                                <TextBox Text="{Binding NewMediaMaterial}" PlaceholderText="Couche, termico, BOPP" />
                                <TextBlock Text="Corner radius (cm)"
                                           FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                <NumericUpDown Value="{Binding NewMediaRadiusCm}" Minimum="0" Maximum="2"
                                               Increment="0.05" FormatString="0.###" />
                                <CheckBox Content="Continuous roll" FontSize="12"
                                          IsChecked="{Binding NewMediaContinuous}" />
                                <Button Content="Save" HorizontalAlignment="Stretch"
                                        Command="{Binding SaveUserMediaCommand}" />

                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="My media" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Nothing saved yet. Set the width and height, then save them under a name."
                                           IsVisible="{Binding !HasUserMedia}"
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding UserMedia}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:UserMediaEntryViewModel">
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Remove"
                                                        FontSize="11" Padding="6,2"
                                                        Command="{Binding RemoveCommand}" />
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,6,0" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Separator Margin="0,10,0,12" />
                <WrapPanel>
                    <StackPanel Width="288" Margin="0,0,12,0" Spacing="8">
                        <TextBlock Text="Label size" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Width (cm)" />
                        <NumericUpDown Name="LabelWidthInput" Value="{Binding WidthCm}" Minimum="0.5" Maximum="60"
                                       Increment="0.1" FormatString="0.###" />
                        <TextBlock Text="Height (cm)" />
                        <NumericUpDown Name="LabelHeightInput" Value="{Binding HeightCm}" Minimum="0.5" Maximum="100"
                                       Increment="0.1" FormatString="0.###"
                                       IsEnabled="{Binding HasFixedLength}"
                                       ToolTip.Tip="{Binding LengthHint}" />
                        <CheckBox Content="Continuous roll" IsChecked="{Binding IsContinuous}"
                                  ToolTip.Tip="Stock with no gaps or die cuts. The label becomes as long as its content." />
                        <TextBlock Text="Gap after label (cm)"
                                   IsVisible="{Binding IsContinuous}"
                                   ToolTip.Tip="Blank stock after the last ink, before the next label starts." />
                        <NumericUpDown Value="{Binding ContinuousMarginCm}" Minimum="0" Maximum="5"
                                       Increment="0.05" FormatString="0.###"
                                       IsVisible="{Binding IsContinuous}" />
                        <TextBlock Text="Corner radius (cm)"
                                   IsVisible="{Binding HasFixedLength}"
                                   ToolTip.Tip="Shapes the canvas and exported PDF to match a die-cut label. It does not change the ZPL." />
                        <NumericUpDown Value="{Binding CornerRadiusCm}" Minimum="0" Maximum="5"
                                       Increment="0.05" FormatString="0.###"
                                       IsVisible="{Binding HasFixedLength}" />
                    </StackPanel>

                    <StackPanel Width="288" Spacing="8">
                        <TextBlock Text="Roll layout" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Labels across"
                                   ToolTip.Tip="How many labels sit side by side on the roll. The design remains one label." />
                        <NumericUpDown Value="{Binding LabelsAcross}" Minimum="1" Maximum="20"
                                       Increment="1" FormatString="0" ToolTip.Tip="{Binding AcrossHint}" />
                        <TextBlock Text="Gap between columns (cm)"
                                   IsVisible="{Binding IsMultiAcross}"
                                   ToolTip.Tip="Liner between labels that sit side by side." />
                        <NumericUpDown Value="{Binding AcrossGapCm}" Minimum="0" Maximum="5"
                                       Increment="0.05" FormatString="0.###"
                                       IsVisible="{Binding IsMultiAcross}" />

                        <Separator Margin="0,10,0,8" />
                        <TextBlock Text="Printer" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Density" />
                        <ComboBox Name="DensityInput" ItemsSource="{Binding Densities}"
                                  SelectedItem="{Binding SelectedDensity}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Printer profile" />
                        <ComboBox Name="PrinterInput" ItemsSource="{Binding Printers}"
                                  SelectedItem="{Binding SelectedPrinter}" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Selecting a printer adopts its density and checks the label against the print head." />
                        <TextBlock Text="{Binding PrinterWarning}" Foreground="#D97706" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Text="Changes apply to the label immediately." VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
            <Button Grid.Column="1" Content="Close" Click="OnClose" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
