<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelForge.App.ViewModels"
        xmlns:controls="using:LabelForge.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="720"
        x:Class="LabelForge.App.Views.DesignerView"
        x:DataType="vm:DesignerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Square icon buttons in the left tool bar -->
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tool.armed">
            <Setter Property="Background" Value="#2E2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>

        <DataTemplate DataType="vm:TextPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Text" />
                <AutoCompleteBox Text="{Binding Text}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Font height (dots)" />
                <NumericUpDown Value="{Binding FontHeight}" Minimum="6" Maximum="600"
                               Increment="2" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Font width (dots, 0 = auto)" />
                <NumericUpDown Value="{Binding FontWidth}" Minimum="0" Maximum="600"
                               Increment="2" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Block width (dots, 0 = single line)"
                           Margin="0,8,0,0" />
                <NumericUpDown Value="{Binding BlockWidth}" Minimum="0" Maximum="9999"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Alignment" IsVisible="{Binding IsBlock}" />
                <ComboBox ItemsSource="{Binding Justifications}"
                          SelectedItem="{Binding Justification}"
                          IsVisible="{Binding IsBlock}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Maximum lines" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockMaxLines}" Minimum="1" Maximum="9999"
                               Increment="1" FormatString="0" IsVisible="{Binding IsBlock}" />
                <TextBlock Text="The preview always draws every line. A printer stops at this many."
                           IsVisible="{Binding IsBlock}" Foreground="#D97706"
                           TextWrapping="Wrap" FontSize="12" />
                <TextBlock Classes="propLabel" Text="Line spacing (dots)" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockLineSpacing}" Minimum="-200" Maximum="200"
                               Increment="2" FormatString="0" IsVisible="{Binding IsBlock}" />
                <TextBlock Classes="propLabel" Text="Hanging indent (dots)" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockHangingIndent}" Minimum="0" Maximum="9999"
                               Increment="10" FormatString="0" IsVisible="{Binding IsBlock}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BarcodePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Gs1Breakdown}" IsVisible="{Binding IsGs1}"
                           Opacity="0.6" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           ToolTip.Tip="The application identifiers this payload carries" />
                <TextBlock Text="{Binding Gs1Warning}" IsVisible="{Binding HasGs1Warning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Classes="propLabel" Text="Symbology" />
                <ComboBox ItemsSource="{Binding Symbologies}"
                          SelectedItem="{Binding Symbology}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Height (dots)" />
                <NumericUpDown Value="{Binding Height}" Minimum="10" Maximum="2000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Module width (dots, 1-10)" />
                <NumericUpDown Value="{Binding ModuleWidth}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <StackPanel IsVisible="{Binding IsCode39}" Spacing="4">
                    <TextBlock Classes="propLabel" Text="Wide bar ratio (Code 39)" />
                    <NumericUpDown Value="{Binding Ratio}" Minimum="2" Maximum="3"
                                   Increment="0.1" FormatString="0.0" />
                </StackPanel>
                <CheckBox Content="Print interpretation line"
                          IsChecked="{Binding Interpretation}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:QrPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Magnification (1-10)" />
                <NumericUpDown Value="{Binding Magnification}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Error correction" />
                <ComboBox ItemsSource="{Binding ErrorCorrections}"
                          SelectedItem="{Binding ErrorCorrection}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DataMatrixPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Module size (dots, 1-20)" />
                <NumericUpDown Value="{Binding ModuleSize}" Minimum="1" Maximum="20"
                               Increment="1" FormatString="0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:Pdf417PropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding ShapeInfo}" Opacity="0.6" FontSize="12" />
                <TextBlock IsVisible="{Binding HasWarning}" Text="{Binding Warning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Classes="propLabel" Text="Data columns (0 = automatic)" />
                <NumericUpDown Value="{Binding Columns}" Minimum="0" Maximum="30"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="The column count decides whether the symbol is a wide strip or a tall block. Automatic leaves that choice to the printer." />
                <TextBlock Classes="propLabel" Text="Module width (dots, 1-10)" />
                <NumericUpDown Value="{Binding ModuleWidth}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Row height (dots)" />
                <NumericUpDown Value="{Binding RowHeight}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Error correction level (0-8)" />
                <NumericUpDown Value="{Binding SecurityLevel}" Minimum="0" Maximum="8"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="Higher levels survive more damage and make the symbol bigger. Level 0 detects errors without correcting them." />
                <CheckBox Content="Truncated" IsChecked="{Binding Truncate}" Margin="0,4,0,0"
                          ToolTip.Tip="Drops the right row indicator to save width. Only for controlled scanning setups." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ImagePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SourceInfo}" Opacity="0.6" FontSize="12" />
                <TextBlock Classes="propLabel" Text="Width (dots)" />
                <NumericUpDown Value="{Binding ImageWidth}" Minimum="8" Maximum="5000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Height (dots)" />
                <NumericUpDown Value="{Binding ImageHeight}" Minimum="8" Maximum="5000"
                               Increment="10" FormatString="0" />
                <Button Content="Restore aspect ratio" Command="{Binding RestoreAspectCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Re-derives the height from the width using the source image proportions" />
                <TextBlock Classes="propLabel" Text="Dithering" />
                <ComboBox ItemsSource="{Binding DitherModes}"
                          SelectedItem="{Binding Dithering}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Threshold for logos and line art, Floyd-Steinberg for photos" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:LinePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Length (dots)" />
                <NumericUpDown Value="{Binding Length}" Minimum="1" Maximum="5000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <CheckBox Content="Vertical" IsChecked="{Binding IsVertical}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BoxPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Width (dots)" />
                <NumericUpDown Value="{Binding BoxWidth}" Minimum="4" Maximum="5000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Height (dots)" />
                <NumericUpDown Value="{Binding BoxHeight}" Minimum="4" Maximum="5000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Border thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
            </StackPanel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <DockPanel>

        <!-- Menu bar -->
        <Border DockPanel.Dock="Top" Padding="4,0" Background="{DynamicResource AppBarBackground}">
            <DockPanel>
                <Menu DockPanel.Dock="Left" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="New from _Sample" Command="{Binding LoadSampleCommand}" />
                        <MenuItem Header="_Open..." Click="OnOpenFile" InputGesture="Ctrl+O" />
                        <MenuItem x:Name="RecentMenu" Header="Open _Recent" IsEnabled="{Binding HasRecentFiles}" />
                        <MenuItem Header="_Import ZPL..." Click="OnImportZpl" />
                        <Separator />
                        <MenuItem Header="_Save" Click="OnSaveFile" InputGesture="Ctrl+S" />
                        <MenuItem Header="Save _As..." Click="OnSaveFileAs" />
                        <Separator />
                        <MenuItem Header="Export _ZPL..." Click="OnExportZpl" />
                        <MenuItem Header="Export _PNG..." Click="OnExportPng" />
                        <MenuItem Header="Export P_DF..." Click="OnExportPdf" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                        <MenuItem Header="D_uplicate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" />
                        <Separator />
                        <MenuItem Header="Bring to _Front" Command="{Binding BringToFrontCommand}" />
                        <MenuItem Header="Send to _Back" Command="{Binding SendToBackCommand}" />
                        <Separator />
                        <MenuItem Header="A_lign">
                            <MenuItem Header="_Left" Command="{Binding AlignLeftCommand}" />
                            <MenuItem Header="_Center" Command="{Binding AlignCenterHorizontalCommand}" />
                            <MenuItem Header="_Right" Command="{Binding AlignRightCommand}" />
                            <Separator />
                            <MenuItem Header="_Top" Command="{Binding AlignTopCommand}" />
                            <MenuItem Header="_Middle" Command="{Binding AlignMiddleCommand}" />
                            <MenuItem Header="_Bottom" Command="{Binding AlignBottomCommand}" />
                            <Separator />
                            <MenuItem Header="Distribute _Horizontally" Command="{Binding DistributeHorizontalCommand}" />
                            <MenuItem Header="Distribute _Vertically" Command="{Binding DistributeVerticalCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Delete" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Theme: _System" Click="OnThemeSystem" />
                        <MenuItem Header="Theme: _Light" Click="OnThemeLight" />
                        <MenuItem Header="Theme: _Dark" Click="OnThemeDark" />
                    </MenuItem>
                    <MenuItem Header="_Insert">
                        <MenuItem Header="_Text" Command="{Binding AddTextCommand}" />
                        <MenuItem Header="_Box" Command="{Binding AddBoxCommand}" />
                        <MenuItem Header="_Line" Command="{Binding AddLineCommand}" />
                        <MenuItem Header="Ba_rcode" Command="{Binding AddBarcodeCommand}" />
                        <MenuItem Header="_QR Code" Command="{Binding AddQrCommand}" />
                        <MenuItem Header="_Data Matrix" Command="{Binding AddDataMatrixCommand}" />
                        <MenuItem Header="_PDF417" Command="{Binding AddPdf417Command}" />
                        <MenuItem Header="_Image..." Click="OnAddImage" />
                        <Separator />
                        <MenuItem Header="_Graphics from a ZPL file..." Click="OnImportGraphics" />
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Content="Print..." Margin="4,4">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" Width="240">
                                <TextBlock Text="Job settings (saved with the label)" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Copies" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintCopies}" Minimum="1" Maximum="9999"
                                               Increment="1" FormatString="0" />
                                <TextBlock Text="Darkness adjust (0 = printer default)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintDarkness}" Minimum="-30" Maximum="30"
                                               Increment="1" FormatString="0" />
                                <TextBlock Text="Speed, inches per second (0 = printer default)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintSpeed}" Minimum="0" Maximum="14"
                                               Increment="1" FormatString="0" />
                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="Network printer (TCP 9100)" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Text="{Binding PrinterHost}" PlaceholderText="192.168.0.50" />
                                <TextBlock Text="Port" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrinterPort}" Minimum="1" Maximum="65535"
                                               Increment="1" FormatString="0" />
                                <Button Content="Send via network" Command="{Binding PrintCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="Windows printer (USB)" FontWeight="SemiBold" FontSize="12" />
                                <ComboBox ItemsSource="{Binding WindowsPrinters}"
                                          SelectedItem="{Binding SelectedWindowsPrinter}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Pick an installed printer" />
                                <Button Content="Send via Windows spooler" Command="{Binding PrintWindowsCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="{Binding CurrentFilePath}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0"
                           Opacity="0.5" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Label setup -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource AppToolbarBackground}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Width (mm)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding WidthMm}" Minimum="5" Maximum="600"
                               Increment="1" FormatString="0.#" Width="110" />
                <TextBlock Text="Height (mm)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding HeightMm}" Minimum="5" Maximum="1000"
                               Increment="1" FormatString="0.#" Width="110"
                               IsEnabled="{Binding HasFixedLength}"
                               ToolTip.Tip="{Binding LengthHint}" />
                <CheckBox Content="Continuous" IsChecked="{Binding IsContinuous}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Stock with no gaps or die cuts. The label becomes exactly as long as its content, and the ZPL tells the printer to stop sensing gaps." />
                <TextBlock Text="Gap (mm)" VerticalAlignment="Center"
                           IsVisible="{Binding IsContinuous}"
                           ToolTip.Tip="Blank stock left after the last ink, so the next label has something to start after." />
                <NumericUpDown Value="{Binding ContinuousMarginMm}" Minimum="0" Maximum="50"
                               Increment="0.5" FormatString="0.##" Width="105"
                               IsVisible="{Binding IsContinuous}" />
                <TextBlock Text="Corner (mm)" VerticalAlignment="Center"
                           IsVisible="{Binding HasFixedLength}"
                           ToolTip.Tip="Die-cut corner radius. Shapes the canvas and the exported PDF so the design is checked against the real label; it never changes the ZPL." />
                <NumericUpDown Value="{Binding CornerRadiusMm}" Minimum="0" Maximum="50"
                               Increment="0.5" FormatString="0.##" Width="105"
                               IsVisible="{Binding HasFixedLength}" />
                <CheckBox Content="Quiet zones" IsChecked="{Binding CheckQuietZones}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Warn when something crowds the blank margin a barcode needs to scan. A design aid only: it never changes the generated ZPL." />
                <TextBlock Text="Media" VerticalAlignment="Center"
                           ToolTip.Tip="Set the label size from a Zebra part number or one of your own saved media" />
                <AutoCompleteBox x:Name="MediaBox" Width="230"
                                 PlaceholderText="Part number or my media"
                                 ItemsSource="{Binding MediaCatalog}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 FilterMode="Custom"
                                 MinimumPrefixLength="2" />
                <Button Content="My media..."
                        ToolTip.Tip="Save the current label size as your own media, for stock the Zebra catalog does not list">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" Width="270">
                                <TextBlock Text="Save this size as my media" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding NewMediaSizeText}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="Name" FontSize="12" Opacity="0.8" />
                                <TextBox Text="{Binding NewMediaName}" PlaceholderText="Etiqueta 50 x 30" />
                                <TextBlock Text="Material (optional)" FontSize="12" Opacity="0.8" />
                                <TextBox Text="{Binding NewMediaMaterial}" PlaceholderText="Couche, termico, BOPP" />
                                <TextBlock Text="Corner radius in mm (recorded, not drawn yet)"
                                           FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                <NumericUpDown Value="{Binding NewMediaRadiusMm}" Minimum="0" Maximum="20"
                                               Increment="0.5" FormatString="0.##" />
                                <CheckBox Content="Continuous roll" FontSize="12"
                                          IsChecked="{Binding NewMediaContinuous}" />
                                <Button Content="Save" HorizontalAlignment="Stretch"
                                        Command="{Binding SaveUserMediaCommand}" />

                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="My media" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Nothing saved yet. Set the width and height, then save them under a name."
                                           IsVisible="{Binding !HasUserMedia}"
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding UserMedia}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:UserMediaEntryViewModel">
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Remove"
                                                        FontSize="11" Padding="6,2"
                                                        Command="{Binding RemoveCommand}" />
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,6,0" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="Density" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Densities}"
                          SelectedItem="{Binding SelectedDensity}" Width="100" />
                <Rectangle Width="1" Height="22" Fill="{DynamicResource AppSeparator}" />
                <TextBlock Text="Printer" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding SelectedPrinter}" MinWidth="160"
                          ToolTip.Tip="Selecting a printer adopts its density and validates the label against the print head" />
                <TextBlock Text="{Binding PrinterWarning}" VerticalAlignment="Center"
                           Foreground="#D97706" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="300" />
                <TextBlock Text="{Binding ValidationWarning}" VerticalAlignment="Center"
                           IsVisible="{Binding ValidationWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#D97706" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="300"
                           ToolTip.Tip="{Binding ValidationWarning}" />
                <TextBlock Text="{Binding PlacementWarning}" VerticalAlignment="Center"
                           IsVisible="{Binding PlacementWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#D97706" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="340"
                           ToolTip.Tip="{Binding PlacementWarning}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>
        </Border>

        <!-- Properties panel -->
        <Border DockPanel.Dock="Right" Width="260" Background="{DynamicResource AppPanelBackground}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <!-- Which data source's fields this label is written against -->
                    <StackPanel Spacing="4">
                        <DockPanel>
                            <TextBlock Text="Fields" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Manage..." Padding="8,2" FontSize="11"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="Import a field list, or remove one you no longer use">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="6" Width="300">
                                            <TextBlock Text="Field catalogs" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                                       Text="A catalog is the list of fields the system that fills your markers can provide. Import the list it exports and give it your own name for this kind of label. Import a script beside it and its functions can be completed too." />
                                            <TextBlock Text="Name (optional; the file name is used if blank)"
                                                       FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding NewCatalogName}"
                                                     PlaceholderText="Etiqueta externa (caixaria)" />
                                            <Button Content="Import a field list or script..."
                                                    Click="OnImportFieldCatalog"
                                                    HorizontalAlignment="Stretch" />
                                            <Rectangle Height="1" Fill="{DynamicResource AppSeparator}"
                                                       IsVisible="{Binding HasFieldCatalogs}" />
                                            <ItemsControl ItemsSource="{Binding FieldCatalogs}"
                                                          IsVisible="{Binding HasFieldCatalogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:FieldCatalogEntryViewModel">
                                                        <DockPanel Margin="0,2">
                                                            <Button DockPanel.Dock="Right" Content="Remove"
                                                                    FontSize="11" Padding="6,2"
                                                                    Command="{Binding RemoveCommand}" />
                                                            <TextBlock Text="{Binding Display}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding CatalogChoices}"
                                  SelectedItem="{Binding SelectedFieldCatalog}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="No catalog"
                                  ToolTip.Tip="The fields this label can use. Picking one turns on completion in the text and data boxes and flags markers the catalog does not list." />
                        <TextBlock Text="{Binding UnknownFieldWarning}"
                                   IsVisible="{Binding UnknownFieldWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#D97706" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="Properties" FontWeight="SemiBold" />

                    <TextBlock Text="Nothing selected. Click an element on the canvas. Drag on empty space to select several; Ctrl+click adds or removes."
                               IsVisible="{Binding !HasSelection}"
                               TextWrapping="Wrap" Opacity="0.6" FontSize="12" />

                    <TextBlock Text="{Binding SelectionCount, StringFormat='{}{0} elements selected. Drag to move them together; Delete removes all; copy and z-order apply to the whole group.'}"
                               IsVisible="{Binding HasMultiSelection}"
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                    <StackPanel IsVisible="{Binding IsSingleSelection}" Spacing="4">
                        <TextBlock Text="{Binding SelectionProperties.TypeName, FallbackValue=''}"
                                   FontWeight="SemiBold" Opacity="0.8" />
                        <CheckBox Content="Positions in mm" FontSize="12" Margin="0,2,0,0"
                                  IsChecked="{Binding SelectionProperties.UseMm, FallbackValue=false}"
                                  ToolTip.Tip="Type X and Y in millimeters; the label model keeps dots" />
                        <TextBlock Classes="propLabel"
                                   Text="{Binding SelectionProperties.UnitSuffix, StringFormat='X ({0})', FallbackValue='X (dots)'}" />
                        <NumericUpDown Value="{Binding SelectionProperties.X, FallbackValue=0}"
                                       Increment="1"
                                       FormatString="{Binding SelectionProperties.PositionFormat, FallbackValue=0}"
                                       Minimum="-9999" />
                        <TextBlock Classes="propLabel"
                                   Text="{Binding SelectionProperties.UnitSuffix, StringFormat='Y ({0})', FallbackValue='Y (dots)'}" />
                        <NumericUpDown Value="{Binding SelectionProperties.Y, FallbackValue=0}"
                                       Increment="1"
                                       FormatString="{Binding SelectionProperties.PositionFormat, FallbackValue=0}"
                                       Minimum="-9999" />
                        <TextBlock Classes="propLabel" Text="Rotation" />
                        <ComboBox ItemsSource="{Binding SelectionProperties.Orientations, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding SelectionProperties.SelectedOrientation, FallbackValue={x:Null}}"
                                  HorizontalAlignment="Stretch" />
                        <CheckBox Content="Reverse (knock out of the ink below)" FontSize="12" Margin="0,4,0,0"
                                  IsChecked="{Binding SelectionProperties.IsReversed, FallbackValue=false}"
                                  ToolTip.Tip="^FR: prints white where this field crosses black. Over blank stock it prints nothing." />
                        <CheckBox Content="Lock position" FontSize="12"
                                  IsChecked="{Binding SelectionProperties.IsLocked, FallbackValue=false}"
                                  ToolTip.Tip="Blocks dragging, resizing and alignment on the canvas. These fields still edit it." />
                        <CheckBox Content="Do not print" FontSize="12"
                                  IsChecked="{Binding SelectionProperties.DoNotPrint, FallbackValue=false}"
                                  ToolTip.Tip="Stays on the canvas, outlined in grey, and is left out of the exported and printed ZPL." />

                        <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,8" />

                        <!-- Type-specific editor, picked by DataTemplate -->
                        <ContentControl Content="{Binding SelectionProperties}" />

                        <TextBlock Text="Drag to move. Corner handles resize proportionally; edge handles resize one axis (barcodes snap to module steps). The round handle rotates; ZPL printers only support 0/90/180/270. Arrow keys nudge by 1 dot (Shift = 10). Delete removes. Ctrl+Z / Ctrl+Y undo and redo."
                                   TextWrapping="Wrap" Opacity="0.5" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Template variables found on the label -->
                    <StackPanel IsVisible="{Binding HasVariables}" Spacing="4" Margin="0,10,0,0">
                        <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" />
                        <TextBlock Text="Variables" FontWeight="SemiBold" />
                        <TextBlock Text="The ##markers## on this label. One filled at print keeps its marker in the exported and printed ZPL; counters and dates are filled in for you."
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
                        <TextBlock Text="{Binding VariableWarning}"
                                   IsVisible="{Binding VariableWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#D97706" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Variables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VariableSampleViewModel">
                                    <StackPanel Spacing="2" Margin="0,6,0,0">
                                        <TextBlock Classes="propLabel" Text="{Binding Name}" />
                                        <ComboBox ItemsSource="{Binding Kinds}"
                                                  SelectedItem="{Binding SelectedKind}"
                                                  HorizontalAlignment="Stretch" />

                                        <TextBox IsVisible="{Binding IsExternal}"
                                                 Text="{Binding Sample}"
                                                 PlaceholderText="{Binding DefaultHint}"
                                                 ToolTip.Tip="Preview value only; the marker itself is what gets printed" />

                                        <StackPanel IsVisible="{Binding IsCounter}" Spacing="2">
                                            <TextBlock Classes="propLabel" Text="Start" />
                                            <NumericUpDown Value="{Binding CounterStart}"
                                                           Minimum="0" Maximum="999999999999"
                                                           Increment="1" FormatString="0" />
                                            <TextBlock Classes="propLabel" Text="Step (negative counts down)" />
                                            <NumericUpDown Value="{Binding CounterStep}"
                                                           Minimum="-999999" Maximum="999999"
                                                           Increment="1" FormatString="0" />
                                            <TextBlock Classes="propLabel" Text="Digits (0 = no padding)" />
                                            <NumericUpDown Value="{Binding CounterPadding}"
                                                           Minimum="0" Maximum="12"
                                                           Increment="1" FormatString="0" />
                                            <CheckBox Content="Let the printer count (^SN)" FontSize="12"
                                                      IsChecked="{Binding UsePrinterCounter}"
                                                      ToolTip.Tip="Sends one job and lets the printer serialize the run, which is much faster for long runs" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding IsClock}" Spacing="2">
                                            <TextBlock Classes="propLabel" Text="Format" />
                                            <ComboBox ItemsSource="{Binding ClockFormats}"
                                                      SelectedItem="{Binding SelectedClockPreset}"
                                                      PlaceholderText="Pick a format"
                                                      HorizontalAlignment="Stretch" />
                                            <TextBox Text="{Binding ClockFormat}"
                                                     PlaceholderText="dd/MM/yyyy"
                                                     ToolTip.Tip="Date format: dd, MM, yyyy, yy, HH, mm, ss" />
                                            <CheckBox Content="Use the printer's clock (^FC)" FontSize="12"
                                                      IsChecked="{Binding UsePrinterClock}"
                                                      ToolTip.Tip="Requires the real time clock option on the printer" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding PreviewValue}"
                                                   IsVisible="{Binding PreviewValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontFamily="Consolas,Menlo,Monospace" FontSize="11"
                                                   Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding KindHint}"
                                                   IsVisible="{Binding KindHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Generated ZPL -->
        <Expander DockPanel.Dock="Bottom" Header="Generated ZPL" IsExpanded="False">
            <TextBox Text="{Binding GeneratedZpl}" IsReadOnly="True"
                     FontFamily="Consolas,Menlo,Monospace" FontSize="12"
                     Height="140" TextWrapping="NoWrap" />
        </Expander>

        <!-- Tool bar: insert tools, then alignment, as square icon buttons -->
        <Border DockPanel.Dock="Left" Background="{DynamicResource AppToolbarBackground}" Padding="5,8">
            <StackPanel Spacing="3">
                <Button Classes="tool" Classes.armed="{Binding IsTextArmed}"
                        Command="{Binding AddTextCommand}" ToolTip.Tip="Add text">
                    <PathIcon Data="M2,2 L14,2 L14,5 L9.4,5 L9.4,14 L6.6,14 L6.6,5 L2,5 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsBoxArmed}"
                        Command="{Binding AddBoxCommand}" ToolTip.Tip="Add box">
                    <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z M3.8,4.8 L12.2,4.8 L12.2,11.2 L3.8,11.2 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsLineArmed}"
                        Command="{Binding AddLineCommand}" ToolTip.Tip="Add line">
                    <PathIcon Data="M2.2,12.4 L12.4,2.2 L13.8,3.6 L3.6,13.8 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsBarcodeArmed}"
                        Command="{Binding AddBarcodeCommand}" ToolTip.Tip="Add barcode">
                    <PathIcon Data="M2,3 L3.4,3 L3.4,13 L2,13 Z M4.6,3 L5.6,3 L5.6,13 L4.6,13 Z M7,3 L9.4,3 L9.4,13 L7,13 Z M10.6,3 L11.6,3 L11.6,13 L10.6,13 Z M12.8,3 L14,3 L14,13 L12.8,13 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsQrArmed}"
                        Command="{Binding AddQrCommand}" ToolTip.Tip="Add QR code">
                    <PathIcon Data="M2,2 L7,2 L7,7 L2,7 Z M3.6,3.6 L5.4,3.6 L5.4,5.4 L3.6,5.4 Z M9,2 L14,2 L14,7 L9,7 Z M10.6,3.6 L12.4,3.6 L12.4,5.4 L10.6,5.4 Z M2,9 L7,9 L7,14 L2,14 Z M3.6,10.6 L5.4,10.6 L5.4,12.4 L3.6,12.4 Z M9,9 L11,9 L11,11 L9,11 Z M12,9 L14,9 L14,11 L12,11 Z M9,12 L11,12 L11,14 L9,14 Z M12,12 L14,12 L14,14 L12,14 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsDataMatrixArmed}"
                        Command="{Binding AddDataMatrixCommand}" ToolTip.Tip="Add Data Matrix">
                    <PathIcon Data="M2,2 L3.6,2 L3.6,14 L2,14 Z M2,12.4 L14,12.4 L14,14 L2,14 Z M5,2 L6.6,2 L6.6,3.6 L5,3.6 Z M8,2 L9.6,2 L9.6,3.6 L8,3.6 Z M11,2 L12.6,2 L12.6,3.6 L11,3.6 Z M12.4,5 L14,5 L14,6.6 L12.4,6.6 Z M12.4,8 L14,8 L14,9.6 L12.4,9.6 Z M6,5 L7.6,5 L7.6,6.6 L6,6.6 Z M9,7 L10.6,7 L10.6,8.6 L9,8.6 Z M5.5,9 L7.1,9 L7.1,10.6 L5.5,10.6 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsPdf417Armed}"
                        Command="{Binding AddPdf417Command}" ToolTip.Tip="Add PDF417">
                    <PathIcon Data="M2,2.4 L3.2,2.4 L3.2,4.6 L2,4.6 Z M4,2.4 L4.8,2.4 L4.8,4.6 L4,4.6 Z M5.6,2.4 L7.2,2.4 L7.2,4.6 L5.6,4.6 Z M8,2.4 L8.8,2.4 L8.8,4.6 L8,4.6 Z M9.6,2.4 L11.6,2.4 L11.6,4.6 L9.6,4.6 Z M12.4,2.4 L14,2.4 L14,4.6 L12.4,4.6 Z M2,5.6 L3.6,5.6 L3.6,7.8 L2,7.8 Z M4.4,5.6 L5.2,5.6 L5.2,7.8 L4.4,7.8 Z M6,5.6 L8,5.6 L8,7.8 L6,7.8 Z M8.8,5.6 L9.6,5.6 L9.6,7.8 L8.8,7.8 Z M10.4,5.6 L11.2,5.6 L11.2,7.8 L10.4,7.8 Z M12,5.6 L14,5.6 L14,7.8 L12,7.8 Z M2,8.8 L3.2,8.8 L3.2,11 L2,11 Z M4,8.8 L6,8.8 L6,11 L4,11 Z M6.8,8.8 L7.6,8.8 L7.6,11 L6.8,11 Z M8.4,8.8 L10,8.8 L10,11 L8.4,11 Z M10.8,8.8 L11.6,8.8 L11.6,11 L10.8,11 Z M12.4,8.8 L14,8.8 L14,11 L12.4,11 Z M2,12 L3.6,12 L3.6,14.2 L2,14.2 Z M4.4,12 L5.2,12 L5.2,14.2 L4.4,14.2 Z M6,12 L6.8,12 L6.8,14.2 L6,14.2 Z M7.6,12 L9.6,12 L9.6,14.2 L7.6,14.2 Z M10.4,12 L11.2,12 L11.2,14.2 L10.4,14.2 Z M12,12 L14,12 L14,14.2 L12,14.2 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsImageArmed}"
                        Click="OnAddImage" ToolTip.Tip="Add image (PNG, JPEG, BMP)">
                    <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z M3.4,4.4 L12.6,4.4 L12.6,11.6 L3.4,11.6 Z M4.8,5.6 L6.8,5.6 L6.8,7.6 L4.8,7.6 Z M4.2,11 L7.6,7.4 L9.4,9.6 L10.9,7.9 L12,11 Z" />
                </Button>

                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="2,5" />

                <Button Classes="tool" Command="{Binding AlignLeftCommand}"
                        ToolTip.Tip="Align left (single element: to the label)">
                    <PathIcon Data="M2,2 L3.6,2 L3.6,14 L2,14 Z M5.2,3.6 L14,3.6 L14,6.4 L5.2,6.4 Z M5.2,9.6 L10.5,9.6 L10.5,12.4 L5.2,12.4 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding AlignCenterHorizontalCommand}"
                        ToolTip.Tip="Align horizontal centers (single element: center on label)">
                    <PathIcon Data="F1 M7.2,2 L8.8,2 L8.8,14 L7.2,14 Z M3,3.6 L13,3.6 L13,6.4 L3,6.4 Z M5,9.6 L11,9.6 L11,12.4 L5,12.4 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding AlignRightCommand}"
                        ToolTip.Tip="Align right (single element: to the label)">
                    <PathIcon Data="M12.4,2 L14,2 L14,14 L12.4,14 Z M2,3.6 L10.8,3.6 L10.8,6.4 L2,6.4 Z M5.5,9.6 L10.8,9.6 L10.8,12.4 L5.5,12.4 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding AlignTopCommand}"
                        ToolTip.Tip="Align top (single element: to the label)">
                    <PathIcon Data="M2,2 L14,2 L14,3.6 L2,3.6 Z M3.6,5.2 L6.4,5.2 L6.4,14 L3.6,14 Z M9.6,5.2 L12.4,5.2 L12.4,10.5 L9.6,10.5 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding AlignMiddleCommand}"
                        ToolTip.Tip="Align vertical centers (single element: center on label)">
                    <PathIcon Data="F1 M2,7.2 L14,7.2 L14,8.8 L2,8.8 Z M3.6,3 L6.4,3 L6.4,13 L3.6,13 Z M9.6,5 L12.4,5 L12.4,11 L9.6,11 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding AlignBottomCommand}"
                        ToolTip.Tip="Align bottom (single element: to the label)">
                    <PathIcon Data="M2,12.4 L14,12.4 L14,14 L2,14 Z M3.6,2 L6.4,2 L6.4,10.8 L3.6,10.8 Z M9.6,5.5 L12.4,5.5 L12.4,10.8 L9.6,10.8 Z" />
                </Button>

                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="2,5" />

                <Button Classes="tool" Command="{Binding DistributeHorizontalCommand}"
                        ToolTip.Tip="Distribute horizontally (needs 3+ elements)">
                    <PathIcon Data="M2,2 L3.6,2 L3.6,14 L2,14 Z M12.4,2 L14,2 L14,14 L12.4,14 Z M6.6,4.5 L9.4,4.5 L9.4,11.5 L6.6,11.5 Z" />
                </Button>
                <Button Classes="tool" Command="{Binding DistributeVerticalCommand}"
                        ToolTip.Tip="Distribute vertically (needs 3+ elements)">
                    <PathIcon Data="M2,2 L14,2 L14,3.6 L2,3.6 Z M2,12.4 L14,12.4 L14,14 L2,14 Z M4.5,6.6 L11.5,6.6 L11.5,9.4 L4.5,9.4 Z" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Canvas with mm rulers (drawn by the control) and scrollbars -->
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
            <controls:DesignerCanvas Name="Canvas"
                                     Underlay="{Binding Underlay}"
                                     UnderlayMarginDots="{Binding UnderlayMarginDots}"
                                     Document="{Binding Document}"
                                     Selection="{Binding Selection}"
                                     IsPlacing="{Binding IsPlacing}" />
            <ScrollBar Name="CanvasVScroll" Grid.Column="1" Orientation="Vertical"
                       AllowAutoHide="False" Visibility="Visible" />
            <ScrollBar Name="CanvasHScroll" Grid.Row="1" Orientation="Horizontal"
                       AllowAutoHide="False" Visibility="Visible" />

            <!-- Floating zoom control over the canvas corner -->
            <Border Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                    Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1"
                    CornerRadius="4" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Name="ZoomOutButton" Content="-" Padding="8,2" FontSize="12"
                            ToolTip.Tip="Zoom out (Ctrl+wheel)" />
                    <Button Name="ZoomLevelButton" Content="100%" MinWidth="58" Padding="6,2"
                            FontSize="12" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Zoom presets; 100% = 1 dot per pixel">
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuItem Header="50%" Click="OnZoom50" />
                                <MenuItem Header="100%" Click="OnZoom100" />
                                <MenuItem Header="200%" Click="OnZoom200" />
                                <MenuItem Header="Fit label" Click="OnZoomFit" InputGesture="Ctrl+0" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Name="ZoomInButton" Content="+" Padding="8,2" FontSize="12"
                            ToolTip.Tip="Zoom in (Ctrl+wheel)" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>

</UserControl>
