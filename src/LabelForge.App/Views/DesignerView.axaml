<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelForge.App.ViewModels"
        xmlns:controls="using:LabelForge.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="720"
        x:Class="LabelForge.App.Views.DesignerView"
        x:DataType="vm:DesignerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.propLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Square icon buttons in the left tool bar -->
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tool.armed">
            <Setter Property="Background" Value="#2E2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style Selector="SplitButton.tool">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="SplitButton.tool.armed">
            <Setter Property="Background" Value="#2E2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style Selector="ListBox#ElementsList ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>

        <DataTemplate DataType="vm:TextPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Text" />
                <AutoCompleteBox Text="{Binding Text}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Font" />
                <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding FontNote}" FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap" />
                <TextBlock Classes="propLabel" Text="Font height (dots)"
                           IsVisible="{Binding IsScalableFont}" />
                <NumericUpDown Value="{Binding FontHeight}" Minimum="6" Maximum="600"
                               Increment="2" FormatString="0"
                               IsVisible="{Binding IsScalableFont}" />
                <TextBlock Classes="propLabel" Text="Font width (dots, 0 = auto)"
                           IsVisible="{Binding IsScalableFont}" />
                <NumericUpDown Value="{Binding FontWidth}" Minimum="0" Maximum="600"
                               Increment="2" FormatString="0"
                               IsVisible="{Binding IsScalableFont}" />
                <TextBlock Classes="propLabel" Text="Size (times the font's own cell)"
                           IsVisible="{Binding !IsScalableFont}" />
                <NumericUpDown Value="{Binding Magnification}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0"
                               IsVisible="{Binding !IsScalableFont}" />
                <TextBlock Classes="propLabel" Text="Block width (dots, 0 = single line)"
                           Margin="0,8,0,0" />
                <NumericUpDown Value="{Binding BlockWidth}" Minimum="0" Maximum="9999"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Alignment" IsVisible="{Binding IsBlock}" />
                <ComboBox ItemsSource="{Binding Justifications}"
                          SelectedItem="{Binding Justification}"
                          IsVisible="{Binding IsBlock}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Maximum lines" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockMaxLines}" Minimum="1" Maximum="9999"
                               Increment="1" FormatString="0" IsVisible="{Binding IsBlock}" />
                <TextBlock Text="The preview always draws every line. A printer stops at this many."
                           IsVisible="{Binding IsBlock}" Foreground="#D97706"
                           TextWrapping="Wrap" FontSize="12" />
                <TextBlock Classes="propLabel" Text="Line spacing (dots)" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockLineSpacing}" Minimum="-200" Maximum="200"
                               Increment="2" FormatString="0" IsVisible="{Binding IsBlock}" />
                <TextBlock Classes="propLabel" Text="Hanging indent (dots)" IsVisible="{Binding IsBlock}" />
                <NumericUpDown Value="{Binding BlockHangingIndent}" Minimum="0" Maximum="9999"
                               Increment="10" FormatString="0" IsVisible="{Binding IsBlock}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BarcodePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Gs1Breakdown}" IsVisible="{Binding IsGs1}"
                           Opacity="0.6" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           ToolTip.Tip="The application identifiers this payload carries" />
                <TextBlock Text="{Binding Gs1Warning}" IsVisible="{Binding HasGs1Warning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding CheckDigitInfo}" IsVisible="{Binding HasCheckDigitInfo}"
                           Opacity="0.6" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           ToolTip.Tip="A check digit is invisible in the ZPL: the printer works it out from the data." />
                <Button Content="Add check digit" Command="{Binding AppendCheckDigitCommand}"
                        IsVisible="{Binding CanAddCheckDigit}" HorizontalAlignment="Left"
                        Margin="0,2,0,0" FontSize="12"
                        ToolTip.Tip="Writes the Mod 10 check digit into the data, so the box shows the number that scans." />
                <TextBlock Classes="propLabel" Text="Symbology" />
                <ComboBox ItemsSource="{Binding Symbologies}"
                          SelectedItem="{Binding Symbology}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Height (dots)" />
                <NumericUpDown Value="{Binding Height}" Minimum="10" Maximum="2000"
                               Increment="10" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Module width (dots, 1-10)" />
                <NumericUpDown Value="{Binding ModuleWidth}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <StackPanel IsVisible="{Binding UsesRatio}" Spacing="4">
                    <TextBlock Classes="propLabel" Text="Wide bar ratio" />
                    <NumericUpDown Value="{Binding Ratio}" Minimum="2" Maximum="3"
                                   Increment="0.1" FormatString="0.0" />
                </StackPanel>
                <CheckBox Content="Printer adds a check digit" IsVisible="{Binding IsInterleaved}"
                          IsChecked="{Binding AddCheckDigit}" Margin="0,4,0,0"
                          ToolTip.Tip="^B2's check-digit parameter. The preview cannot draw it, so the symbol prints wider than it looks." />
                <CheckBox Content="Print interpretation line"
                          IsChecked="{Binding Interpretation}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:QrPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Magnification (1-10)" />
                <NumericUpDown Value="{Binding Magnification}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Error correction" />
                <ComboBox ItemsSource="{Binding ErrorCorrections}"
                          SelectedItem="{Binding ErrorCorrection}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DataMatrixPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Classes="propLabel" Text="Module size (dots, 1-20)" />
                <NumericUpDown Value="{Binding ModuleSize}" Minimum="1" Maximum="20"
                               Increment="1" FormatString="0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:Pdf417PropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="Data" />
                <AutoCompleteBox Text="{Binding Data}" ItemsSource="{Binding FieldSuggestions}"
                                 FilterMode="Custom" MinimumPrefixLength="0"
                                 AttachedToVisualTree="OnFieldBoxAttached"
                                 HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding ShapeInfo}" Opacity="0.6" FontSize="12" />
                <TextBlock IsVisible="{Binding HasWarning}" Text="{Binding Warning}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Classes="propLabel" Text="Data columns (0 = automatic)" />
                <NumericUpDown Value="{Binding Columns}" Minimum="0" Maximum="30"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="The column count decides whether the symbol is a wide strip or a tall block. Automatic leaves that choice to the printer." />
                <TextBlock Classes="propLabel" Text="Module width (dots, 1-10)" />
                <NumericUpDown Value="{Binding ModuleWidth}" Minimum="1" Maximum="10"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Row height (dots)" />
                <NumericUpDown Value="{Binding RowHeight}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="propLabel" Text="Error correction level (0-8)" />
                <NumericUpDown Value="{Binding SecurityLevel}" Minimum="0" Maximum="8"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="Higher levels survive more damage and make the symbol bigger. Level 0 detects errors without correcting them." />
                <CheckBox Content="Truncated" IsChecked="{Binding Truncate}" Margin="0,4,0,0"
                          ToolTip.Tip="Drops the right row indicator to save width. Only for controlled scanning setups." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ImagePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SourceInfo}" Opacity="0.6" FontSize="12" />
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Width ({0})'}" />
                <NumericUpDown Value="{Binding ImageWidth}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Height ({0})'}" />
                <NumericUpDown Value="{Binding ImageHeight}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <Button Content="Restore aspect ratio" Command="{Binding RestoreAspectCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Re-derives the height from the width using the source image proportions" />
                <TextBlock Classes="propLabel" Text="Dithering" />
                <ComboBox ItemsSource="{Binding DitherModes}"
                          SelectedItem="{Binding Dithering}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Threshold for logos and line art, Floyd-Steinberg for photos" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:LinePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Length ({0})'}" />
                <NumericUpDown Value="{Binding Length}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="Thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <CheckBox Content="White (erase)" IsChecked="{Binding IsWhite}"
                          ToolTip.Tip="Draws in white, which clears whatever was drawn under it. Over blank stock it prints nothing." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BoxPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Width ({0})'}" />
                <NumericUpDown Value="{Binding BoxWidth}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Height ({0})'}" />
                <NumericUpDown Value="{Binding BoxHeight}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="Border thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <CheckBox Content="White (erase)" IsChecked="{Binding IsWhite}" Margin="0,4,0,0"
                          ToolTip.Tip="Draws in white, which clears whatever was drawn under it. Over blank stock it prints nothing." />
                <TextBlock Classes="propLabel" Text="Corner rounding (0-8)" />
                <NumericUpDown Value="{Binding CornerRoundness}" Minimum="0" Maximum="8"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="0 is square corners, 8 the heaviest rounding. The radius is that many eighths of half the shorter side, so it keeps its proportion as the box is resized." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:EllipsePropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Width ({0})'}" />
                <NumericUpDown Value="{Binding EllipseWidth}" Minimum="0" Maximum="4095"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Height ({0})'}" />
                <NumericUpDown Value="{Binding EllipseHeight}" Minimum="0" Maximum="4095"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <Button Content="Make it a circle" Command="{Binding MakeCircleCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Matches the height to the width. A circle is an ellipse with equal sides; ZPL's own ^GC draws exactly that." />
                <TextBlock Classes="propLabel" Text="Border thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0"
                               ToolTip.Tip="Grows inward from the outline. At half the shorter side the shape is solid." />
                <CheckBox Content="White (erase)" IsChecked="{Binding IsWhite}" Margin="0,4,0,0"
                          ToolTip.Tip="Draws in white, which clears whatever was drawn under it. Over blank stock it prints nothing." />
                <TextBlock Text="{Binding WhiteNote}" IsVisible="{Binding HasWhiteNote}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DiagonalPropertiesViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Width ({0})'}" />
                <NumericUpDown Value="{Binding DiagonalWidth}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="{Binding UnitSuffix, StringFormat='Height ({0})'}" />
                <NumericUpDown Value="{Binding DiagonalHeight}" Minimum="0" Maximum="5000"
                               Increment="{Binding SizeIncrement}"
                               FormatString="{Binding PositionFormat}" />
                <TextBlock Classes="propLabel" Text="Thickness (dots)" />
                <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="200"
                               Increment="1" FormatString="0" />
                <TextBlock Text="{Binding ThicknessNote}" IsVisible="{Binding HasThicknessNote}"
                           Foreground="#D97706" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <CheckBox Content="White (erase)" IsChecked="{Binding IsWhite}"
                          ToolTip.Tip="Draws in white, which clears whatever was drawn under it. Over blank stock it prints nothing." />
            </StackPanel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <Grid Name="DesignerRoot" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- Menu bar -->
        <Border Grid.Row="0" Padding="4,0" Background="{DynamicResource AppBarBackground}">
            <DockPanel>
                <Menu DockPanel.Dock="Left" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="New from _Sample..." Click="OnNewFromSample" />
                        <MenuItem Header="_Open..." Click="OnOpenFile" InputGesture="Ctrl+O" />
                        <MenuItem x:Name="RecentMenu" Header="Open _Recent" IsEnabled="{Binding HasRecentFiles}" />
                        <MenuItem Header="_Import ZPL..." Click="OnImportZpl" />
                        <Separator />
                        <MenuItem Header="_Save" Click="OnSaveFile" InputGesture="Ctrl+S" />
                        <MenuItem Header="Save _As..." Click="OnSaveFileAs" />
                        <Separator />
                        <MenuItem Header="Export _ZPL..." Click="OnExportZpl"
                                  ToolTip.Tip="The label itself, as the ZPL pane shows it" />
                        <MenuItem Header="Export Print _Job..." Click="OnExportPrintJob"
                                  ToolTip.Tip="Exactly the bytes a print would send: every copy of a run this PC numbers, and the timestamp taken now" />
                        <MenuItem Header="Export _PNG..." Click="OnExportPng" />
                        <MenuItem Header="Export P_DF..." Click="OnExportPdf" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                        <MenuItem Header="Paste in Pl_ace" Command="{Binding PasteInPlaceCommand}"
                                  InputGesture="Ctrl+Shift+V" />
                        <MenuItem Header="D_uplicate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" />
                        <Separator />
                        <MenuItem Header="Align to _label"
                                  ToggleType="CheckBox" IsChecked="{Binding AlignToLabel}"
                                  ToolTip.Tip="Line things up with the label rather than with each other" />
                        <MenuItem Header="Center on La_bel" Command="{Binding CenterOnLabelCommand}" />
                        <MenuItem Header="Same _Width" Command="{Binding MatchWidthCommand}" />
                        <MenuItem Header="Same _Height" Command="{Binding MatchHeightCommand}" />
                        <MenuItem Header="Same Si_ze" Command="{Binding MatchSizeCommand}" />
                        <Separator />
                        <MenuItem Header="_Group" Command="{Binding GroupSelectionCommand}"
                                  InputGesture="Ctrl+G" />
                        <MenuItem Header="Un_group" Command="{Binding UngroupSelectionCommand}"
                                  InputGesture="Ctrl+Shift+G" />
                        <MenuItem Header="_Rotate 90" Command="{Binding Rotate90Command}"
                                  InputGesture="Ctrl+R" />
                        <MenuItem Header="Bring to _Front" Command="{Binding BringToFrontCommand}" />
                        <MenuItem Header="Bring F_orward" Command="{Binding BringForwardCommand}"
                                  InputGesture="Ctrl+Shift+Up" />
                        <MenuItem Header="Send Back_ward" Command="{Binding SendBackwardCommand}"
                                  InputGesture="Ctrl+Shift+Down" />
                        <MenuItem Header="Send to _Back" Command="{Binding SendToBackCommand}" />
                        <Separator />
                        <MenuItem Header="A_lign">
                            <MenuItem Header="_Left" Command="{Binding AlignLeftCommand}" />
                            <MenuItem Header="_Center" Command="{Binding AlignCenterHorizontalCommand}" />
                            <MenuItem Header="_Right" Command="{Binding AlignRightCommand}" />
                            <Separator />
                            <MenuItem Header="_Top" Command="{Binding AlignTopCommand}" />
                            <MenuItem Header="_Middle" Command="{Binding AlignMiddleCommand}" />
                            <MenuItem Header="_Bottom" Command="{Binding AlignBottomCommand}" />
                            <Separator />
                            <MenuItem Header="Distribute _Horizontally" Command="{Binding DistributeHorizontalCommand}" />
                            <MenuItem Header="Distribute _Vertically" Command="{Binding DistributeVerticalCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Delete" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Quiet zones" ToggleType="CheckBox" IsChecked="{Binding CheckQuietZones}" />
                        <MenuItem x:Name="GridMenu" Header="_Grid" />
                        <Separator />
                        <MenuItem Header="Snap to g_uides" ToggleType="CheckBox"
                                  IsChecked="{Binding SnapToGuides}" />
                        <MenuItem Header="Snap to g_rid" ToggleType="CheckBox"
                                  IsChecked="{Binding SnapToGrid}" />
                        <MenuItem Header="Snap to _objects" ToggleType="CheckBox"
                                  IsChecked="{Binding SnapToObjects}"
                                  ToolTip.Tip="Holding Alt escapes all three for one gesture" />
                        <Separator />
                        <MenuItem Header="Theme: _System" Click="OnThemeSystem" />
                        <MenuItem Header="Theme: _Light" Click="OnThemeLight" />
                        <MenuItem Header="Theme: _Dark" Click="OnThemeDark" />
                    </MenuItem>
                    <MenuItem Header="_Insert">
                        <MenuItem Header="_Text" Command="{Binding AddTextCommand}" />
                        <MenuItem Header="_Box" Command="{Binding AddBoxCommand}" />
                        <MenuItem Header="_Line" Command="{Binding AddLineCommand}" />
                        <MenuItem Header="_Ellipse" Command="{Binding AddEllipseCommand}" />
                        <MenuItem Header="Dia_gonal Line" Command="{Binding AddDiagonalCommand}" />
                        <MenuItem Header="Ba_rcode" Command="{Binding AddBarcodeCommand}" />
                        <MenuItem Header="_QR Code" Command="{Binding AddQrCommand}" />
                        <MenuItem Header="_Data Matrix" Command="{Binding AddDataMatrixCommand}" />
                        <MenuItem Header="_PDF417" Command="{Binding AddPdf417Command}" />
                        <MenuItem Header="_Image..." Click="OnAddImage" />
                        <Separator />
                        <MenuItem Header="_Graphics from a ZPL file..." Click="OnImportGraphics" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Keyboard and Mouse..." Click="OnShowShortcuts" />
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Content="Print..." Margin="4,4">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" Width="240">
                                <TextBlock Text="Job settings (saved with the label)" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Copies" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintCopies}" Minimum="1" Maximum="9999"
                                               Increment="1" FormatString="0" />
                                <TextBlock Text="{Binding AcrossHint}" FontSize="11" Opacity="0.7"
                                           TextWrapping="Wrap" IsVisible="{Binding IsMultiAcross}"
                                           ToolTip.Tip="A row is one pull of the media and cannot be part printed, so a quantity that does not divide evenly prints a few extra." />
                                <TextBlock Text="Darkness adjust (0 = printer default)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintDarkness}" Minimum="-30" Maximum="30"
                                               Increment="1" FormatString="0" />
                                <TextBlock Text="Speed, inches per second (0 = printer default)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintSpeed}" Minimum="0" Maximum="14"
                                               Increment="1" FormatString="0" />
                                <TextBlock Text="After printing" FontSize="12" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding MediaHandlingOptions}"
                                          SelectedItem="{Binding SelectedMediaHandling}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip.Tip="^MM: what the printer does with the label once it has printed. Leaving it at the printer's own setting states nothing, so the mode its operator chose stands." />
                                <CheckBox Content="Pre-peel the next label" FontSize="12"
                                          IsChecked="{Binding PrintPrepeel}"
                                          IsVisible="{Binding IsPeelOff}"
                                          ToolTip.Tip="^MM's second parameter: presents the next label before it is asked for. Only a peeler has anything to pre-peel." />
                                <TextBlock Text="Cut after every N labels (0 = off)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintCutAfter}" Minimum="0" Maximum="9999"
                                               Increment="1" FormatString="0"
                                               ToolTip.Tip="^PQ's group value. The printer cuts at the end of each group and carries straight on rather than pausing for someone." />
                                <TextBlock Text="{Binding CutHint}" FontSize="11" Opacity="0.7"
                                           TextWrapping="Wrap" IsVisible="{Binding CutHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="Label top offset, dot rows (0 = printer default)" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrintLabelTop}" Minimum="-120" Maximum="120"
                                               Increment="1" FormatString="0"
                                               ToolTip.Tip="^LT: moves the whole printed format up or down relative to the top edge of the media, to line the print up with the die cut. It stays set on the printer until another label changes it." />
                                <CheckBox Content="Reverse every field" FontSize="12"
                                          IsChecked="{Binding PrintReverseAll}"
                                          ToolTip.Tip="^LR: prints every field the other way round, for white on black stock and pre-printed backgrounds. The same as marking each field reversed, and the canvas shows it." />
                                <CheckBox Content="Mirror the print" FontSize="12"
                                          IsChecked="{Binding PrintMirror}"
                                          ToolTip.Tip="^PM: the printer flips the whole printable area left to right, for stock that is read through its face." />
                                <TextBlock Text="{Binding MirrorHint}" FontSize="11" Opacity="0.7"
                                           TextWrapping="Wrap" IsVisible="{Binding MirrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="Network printer (TCP 9100)" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Text="{Binding PrinterHost}" PlaceholderText="192.168.0.50" />
                                <TextBlock Text="Port" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrinterPort}" Minimum="1" Maximum="65535"
                                               Increment="1" FormatString="0" />
                                <Button Content="Send via network" Command="{Binding PrintCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6" />
                                <TextBlock Text="Windows printer (USB)" FontWeight="SemiBold" FontSize="12" />
                                <ComboBox ItemsSource="{Binding WindowsPrinters}"
                                          SelectedItem="{Binding SelectedWindowsPrinter}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Pick an installed printer" />
                                <Button Content="Send via Windows spooler" Command="{Binding PrintWindowsCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="{Binding CurrentFilePath}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0"
                           Opacity="0.5" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Recovery offer: only after a session that did not shut down -->
        <Border Grid.Row="1" Padding="10,6" Background="#FEF3C7"
                IsVisible="{Binding HasRecoveryOffer}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Discard" Margin="6,0,0,0"
                        Command="{Binding DismissRecoveryCommand}" />
                <Button DockPanel.Dock="Right" Content="Recover"
                        Command="{Binding RecoverDocumentCommand}" />
                <TextBlock Text="{Binding RecoveryOffer}" VerticalAlignment="Center"
                           Foreground="#78350F" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- The other labels in an imported file, while there are any -->
        <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource AppToolbarBackground}"
                IsVisible="{Binding HasImportedBlocks}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Done" Margin="6,0,0,0"
                        Command="{Binding CloseImportedFileCommand}"
                        ToolTip.Tip="Stop offering the other labels from this file" />
                <TextBlock MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImportedFrom}" Text="{Binding ImportedFrom}" VerticalAlignment="Center"
                           Opacity="0.7" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding ImportedBlocks}"
                          SelectedItem="{Binding SelectedImportedBlock}"
                          MinWidth="220"
                          ToolTip.Tip="This file holds several labels. Opening another one replaces what is on the canvas." />
            </DockPanel>
        </Border>

        <Border Name="LabelSetupBar" Grid.Row="3" Padding="12,6" Background="{DynamicResource AppToolbarBackground}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SetupSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SetupSummary}" />
                <Button Name="LabelSetupButton" Grid.Column="1" Content="Label setup..." Click="OnOpenLabelSetup" />
            </Grid>
        </Border>
        <Grid Name="WorkspaceGrid" Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
        <!-- Tool bar: insert tools, then alignment, as square icon buttons -->
        <Border Name="CreationRail" Grid.Column="0" Background="{DynamicResource AppToolbarBackground}" Width="64" Padding="4,10">
            <ScrollViewer Name="CreationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <Button Classes="tool" Classes.armed="{Binding IsTextArmed}"
                        Command="{Binding AddTextCommand}" ToolTip.Tip="Add text" AutomationProperties.Name="text">
                    <PathIcon Data="M2,2 L14,2 L14,5 L9.4,5 L9.4,14 L6.6,14 L6.6,5 L2,5 Z" />
                </Button>
                <SplitButton x:Name="ShapesButton" Classes="tool" Classes.armed="{Binding IsShapeArmed}"
                             Command="{Binding AddShapeCommand}" ToolTip.Tip="Shapes" AutomationProperties.Name="Shapes">
                    <PathIcon Width="16" Height="16" Data="{Binding ShapeIcon}" />
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Box" Command="{Binding AddBoxCommand}" />
                            <MenuItem Header="Ellipse" Command="{Binding AddEllipseCommand}" />
                            <MenuItem Header="Diagonal line" Command="{Binding AddDiagonalCommand}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Classes="tool" Classes.armed="{Binding IsLineArmed}"
                        Command="{Binding AddLineCommand}" ToolTip.Tip="Add line" AutomationProperties.Name="line">
                    <PathIcon Data="M2.2,12.4 L12.4,2.2 L13.8,3.6 L3.6,13.8 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsBarcodeArmed}"
                        Command="{Binding AddBarcodeCommand}" ToolTip.Tip="Add barcode" AutomationProperties.Name="barcode">
                    <PathIcon Data="M2,3 L3.4,3 L3.4,13 L2,13 Z M4.6,3 L5.6,3 L5.6,13 L4.6,13 Z M7,3 L9.4,3 L9.4,13 L7,13 Z M10.6,3 L11.6,3 L11.6,13 L10.6,13 Z M12.8,3 L14,3 L14,13 L12.8,13 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsQrArmed}"
                        Command="{Binding AddQrCommand}" ToolTip.Tip="Add QR code" AutomationProperties.Name="QR code">
                    <PathIcon Data="M2,2 L7,2 L7,7 L2,7 Z M3.6,3.6 L5.4,3.6 L5.4,5.4 L3.6,5.4 Z M9,2 L14,2 L14,7 L9,7 Z M10.6,3.6 L12.4,3.6 L12.4,5.4 L10.6,5.4 Z M2,9 L7,9 L7,14 L2,14 Z M3.6,10.6 L5.4,10.6 L5.4,12.4 L3.6,12.4 Z M9,9 L11,9 L11,11 L9,11 Z M12,9 L14,9 L14,11 L12,11 Z M9,12 L11,12 L11,14 L9,14 Z M12,12 L14,12 L14,14 L12,14 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsDataMatrixArmed}"
                        Command="{Binding AddDataMatrixCommand}" ToolTip.Tip="Add Data Matrix" AutomationProperties.Name="Data Matrix">
                    <PathIcon Data="M2,2 L3.6,2 L3.6,14 L2,14 Z M2,12.4 L14,12.4 L14,14 L2,14 Z M5,2 L6.6,2 L6.6,3.6 L5,3.6 Z M8,2 L9.6,2 L9.6,3.6 L8,3.6 Z M11,2 L12.6,2 L12.6,3.6 L11,3.6 Z M12.4,5 L14,5 L14,6.6 L12.4,6.6 Z M12.4,8 L14,8 L14,9.6 L12.4,9.6 Z M6,5 L7.6,5 L7.6,6.6 L6,6.6 Z M9,7 L10.6,7 L10.6,8.6 L9,8.6 Z M5.5,9 L7.1,9 L7.1,10.6 L5.5,10.6 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsPdf417Armed}"
                        Command="{Binding AddPdf417Command}" ToolTip.Tip="Add PDF417" AutomationProperties.Name="PDF417">
                    <PathIcon Data="M2,2.4 L3.2,2.4 L3.2,4.6 L2,4.6 Z M4,2.4 L4.8,2.4 L4.8,4.6 L4,4.6 Z M5.6,2.4 L7.2,2.4 L7.2,4.6 L5.6,4.6 Z M8,2.4 L8.8,2.4 L8.8,4.6 L8,4.6 Z M9.6,2.4 L11.6,2.4 L11.6,4.6 L9.6,4.6 Z M12.4,2.4 L14,2.4 L14,4.6 L12.4,4.6 Z M2,5.6 L3.6,5.6 L3.6,7.8 L2,7.8 Z M4.4,5.6 L5.2,5.6 L5.2,7.8 L4.4,7.8 Z M6,5.6 L8,5.6 L8,7.8 L6,7.8 Z M8.8,5.6 L9.6,5.6 L9.6,7.8 L8.8,7.8 Z M10.4,5.6 L11.2,5.6 L11.2,7.8 L10.4,7.8 Z M12,5.6 L14,5.6 L14,7.8 L12,7.8 Z M2,8.8 L3.2,8.8 L3.2,11 L2,11 Z M4,8.8 L6,8.8 L6,11 L4,11 Z M6.8,8.8 L7.6,8.8 L7.6,11 L6.8,11 Z M8.4,8.8 L10,8.8 L10,11 L8.4,11 Z M10.8,8.8 L11.6,8.8 L11.6,11 L10.8,11 Z M12.4,8.8 L14,8.8 L14,11 L12.4,11 Z M2,12 L3.6,12 L3.6,14.2 L2,14.2 Z M4.4,12 L5.2,12 L5.2,14.2 L4.4,14.2 Z M6,12 L6.8,12 L6.8,14.2 L6,14.2 Z M7.6,12 L9.6,12 L9.6,14.2 L7.6,14.2 Z M10.4,12 L11.2,12 L11.2,14.2 L10.4,14.2 Z M12,12 L14,12 L14,14.2 L12,14.2 Z" />
                </Button>
                <Button Classes="tool" Classes.armed="{Binding IsImageArmed}"
                        Click="OnAddImage" ToolTip.Tip="Add image (PNG, JPEG, BMP)" AutomationProperties.Name="image (PNG, JPEG, BMP)">
                    <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z M3.4,4.4 L12.6,4.4 L12.6,11.6 L3.4,11.6 Z M4.8,5.6 L6.8,5.6 L6.8,7.6 L4.8,7.6 Z M4.2,11 L7.6,7.4 L9.4,9.6 L10.9,7.9 L12,11 Z" />
                </Button>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas with mm rulers (drawn by the control) and scrollbars -->
        <Grid Grid.Column="1" Name="CanvasRegion" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
            <controls:DesignerCanvas Name="Canvas"
                                     Underlay="{Binding Underlay}"
                                     UnderlayMarginDots="{Binding UnderlayMarginDots}"
                                     CanvasRevision="{Binding CanvasRevision}"
                                     Document="{Binding Document}"
                                     Selection="{Binding Selection}"
                                     IsPlacing="{Binding IsPlacing}"
                                     SnapToGuides="{Binding SnapToGuides}"
                                     SnapToGrid="{Binding SnapToGrid}"
                                     SnapToObjects="{Binding SnapToObjects}" />
            <ScrollBar Name="CanvasVScroll" Grid.Column="1" Orientation="Vertical"
                       AllowAutoHide="False" Visibility="Visible" />
            <ScrollBar Name="CanvasHScroll" Grid.Row="1" Orientation="Horizontal"
                       AllowAutoHide="False" Visibility="Visible" />

            <!-- Pointer and selection coordinates, floating over the opposite corner
                 from the zoom control. Not in the toolbar above: that one is already
                 full, and numbers that change width on every pointer move would shuffle
                 whatever sat beside them. -->
            <Border Grid.Row="0" Grid.Column="0" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                    IsVisible="{Binding CanvasReadout, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1"
                    CornerRadius="4" Padding="8,3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding CanvasReadout}" FontSize="12" Opacity="0.75" />
                    <TextBlock Text="{Binding SnapSummary}" FontSize="12" Opacity="0.55" />
                </StackPanel>
            </Border>

            <!-- Floating zoom control over the canvas corner -->
            <Border Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                    Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1"
                    CornerRadius="4" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Name="ZoomOutButton" Content="-" Padding="8,2" FontSize="12"
                            ToolTip.Tip="Zoom out (Ctrl+wheel)" />
                    <Button Name="ZoomLevelButton" Content="100%" MinWidth="58" Padding="6,2"
                            FontSize="12" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Zoom presets; 100% = 1 dot per pixel">
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuItem Header="50%" Click="OnZoom50" />
                                <MenuItem Header="100%" Click="OnZoom100" />
                                <MenuItem Header="200%" Click="OnZoom200" />
                                <MenuItem Header="Fit label" Click="OnZoomFit" InputGesture="Ctrl+0" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Name="ZoomInButton" Content="+" Padding="8,2" FontSize="12"
                            ToolTip.Tip="Zoom in (Ctrl+wheel)" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Name="InspectorPanel" Grid.Column="2" Width="320" Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="12,8">
                    <TextBlock Text="Inspector" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Name="ArrangeButton" Content="Arrange" Padding="10,4"
                                ToolTip.Tip="{Binding AlignTargetName, StringFormat='Arrange ({0})'}">
                            <Button.Flyout><MenuFlyout Placement="Bottom">
                                <MenuItem Header="Align to label" ToggleType="CheckBox" IsChecked="{Binding AlignToLabel}" />
                                <Separator />
                                <MenuItem Header="Align left" Command="{Binding AlignLeftCommand}" />
                                <MenuItem Header="Align horizontal centers" Command="{Binding AlignCenterHorizontalCommand}" />
                                <MenuItem Header="Align right" Command="{Binding AlignRightCommand}" />
                                <MenuItem Header="Align top" Command="{Binding AlignTopCommand}" />
                                <MenuItem Header="Align vertical centers" Command="{Binding AlignMiddleCommand}" />
                                <MenuItem Header="Align bottom" Command="{Binding AlignBottomCommand}" />
                                <MenuItem Header="Center on label" Command="{Binding CenterOnLabelCommand}" />
                                <Separator />
                                <MenuItem Header="Distribute horizontally" Command="{Binding DistributeHorizontalCommand}" />
                                <MenuItem Header="Distribute vertically" Command="{Binding DistributeVerticalCommand}" />
                                <MenuItem Header="Same width" Command="{Binding MatchWidthCommand}" />
                                <MenuItem Header="Same height" Command="{Binding MatchHeightCommand}" />
                                <MenuItem Header="Same size" Command="{Binding MatchSizeCommand}" />
                                <Separator />
                                <MenuItem Header="Group" Command="{Binding GroupSelectionCommand}" />
                                <MenuItem Header="Ungroup" Command="{Binding UngroupSelectionCommand}" />
                                <Separator />
                                <MenuItem Header="Bring to front" Command="{Binding BringToFrontCommand}" />
                                <MenuItem Header="Bring forward" Command="{Binding BringForwardCommand}" />
                                <MenuItem Header="Send backward" Command="{Binding SendBackwardCommand}" />
                                <MenuItem Header="Send to back" Command="{Binding SendToBackCommand}" />
                            </MenuFlyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <TabControl Name="InspectorTabs" Grid.Row="1" Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,8" /></Style>
                    </TabControl.Styles>
                    <TabItem Header="Properties">
                        <ScrollViewer Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="12">
                                <TextBlock Text="Select an element to edit its properties." IsVisible="{Binding !HasSelection}"
                                           TextWrapping="Wrap" Opacity="0.65" />
                                <TextBlock Text="{Binding SelectionCount, StringFormat='{}{0} elements selected. Use Arrange for alignment, sizing and grouping.'}"
                                           IsVisible="{Binding HasMultiSelection}" TextWrapping="Wrap" />
                                <StackPanel IsVisible="{Binding IsSingleSelection}" Spacing="8">
                        <TextBlock Text="{Binding SelectionProperties.TypeName, FallbackValue=''}"
                                   FontWeight="SemiBold" Opacity="0.8" />
                        <TextBlock Classes="propLabel" Text="Name" />
                        <TextBox Text="{Binding SelectionProperties.Name, FallbackValue=''}"
                                 PlaceholderText="{Binding SelectionProperties.TypeName, FallbackValue=''}" />
                                    <Expander Name="ContentSection" Header="Content" IsExpanded="True" HorizontalAlignment="Stretch">
                                        <ContentControl Name="PropertiesContent" Content="{Binding SelectionProperties}" />
                                    </Expander>
                                    <Expander Header="Position" IsExpanded="True" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6">
                        <CheckBox Content="Positions in mm" FontSize="12" Margin="0,2,0,0"
                                  IsChecked="{Binding SelectionProperties.UseMm, FallbackValue=false}"
                                  ToolTip.Tip="Type X and Y in millimeters; the label model keeps dots" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>                        <TextBlock Classes="propLabel"
                                   Text="{Binding SelectionProperties.UnitSuffix, StringFormat='X ({0})', FallbackValue='X (dots)'}" />
                        <NumericUpDown Name="PositionXInput" Value="{Binding SelectionProperties.X, FallbackValue=0}"
                                       Increment="1"
                                       FormatString="{Binding SelectionProperties.PositionFormat, FallbackValue=0}"
                                       Minimum="-9999" />
</StackPanel>
                            <StackPanel Grid.Column="1">                        <TextBlock Classes="propLabel"
                                   Text="{Binding SelectionProperties.UnitSuffix, StringFormat='Y ({0})', FallbackValue='Y (dots)'}" />
                        <NumericUpDown Name="PositionYInput" Value="{Binding SelectionProperties.Y, FallbackValue=0}"
                                       Increment="1"
                                       FormatString="{Binding SelectionProperties.PositionFormat, FallbackValue=0}"
                                       Minimum="-9999" />
</StackPanel>
                        </Grid>
                        <TextBlock Classes="propLabel" Text="Rotation"
                                   IsVisible="{Binding SelectionProperties.CanRotate, FallbackValue=False}" />
                        <ComboBox ItemsSource="{Binding SelectionProperties.Orientations, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding SelectionProperties.SelectedOrientation, FallbackValue={x:Null}}"
                                  IsVisible="{Binding SelectionProperties.CanRotate, FallbackValue=False}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Classes="propLabel" Text="Anchor" />
                        <ComboBox ItemsSource="{Binding SelectionProperties.Anchors, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding SelectionProperties.SelectedAnchor, FallbackValue={x:Null}}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="^FO places a field by its top-left corner, ^FT by its bottom-left. A baseline-placed field moves when its content changes width, which is how real labels keep a filled-in value anchored." />
                        <TextBlock Text="{Binding SelectionProperties.AnchorHint, FallbackValue=''}"
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Appearance and printing" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="4">
                        <CheckBox Content="Reverse print" FontSize="12" Margin="0,4,0,0"
                                  IsChecked="{Binding SelectionProperties.IsReversed, FallbackValue=false}"
                                  ToolTip.Tip="^FR: prints white where this field crosses black. Over blank stock it prints nothing." />
                        <CheckBox Content="Lock position" FontSize="12"
                                  IsChecked="{Binding SelectionProperties.IsLocked, FallbackValue=false}"
                                  ToolTip.Tip="Blocks dragging, resizing and alignment on the canvas. These fields still edit it." />
                        <CheckBox Content="Do not print" FontSize="12"
                                  IsChecked="{Binding SelectionProperties.DoNotPrint, FallbackValue=false}"
                                  ToolTip.Tip="Stays on the canvas, outlined in grey, and is left out of the exported and printed ZPL." />

                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Button Content="Keyboard and mouse help" Click="OnShowShortcuts" HorizontalAlignment="Left" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Elements">
                        <Grid RowDefinitions="Auto,*" Margin="8">
                            <TextBlock Text="{Binding OutlineHeader}" Opacity="0.65" Margin="4,8" />
                            <Grid Grid.Row="1">
                            <ListBox Name="ElementsList" ItemsSource="{Binding Outline}"
                                     SelectedItem="{Binding SelectedOutlineRow}"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ElementOutlineViewModel">
                                        <Grid ColumnDefinitions="*,28,28">
                                            <TextBlock Text="{Binding Display}" Margin="{Binding Indent}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Display}" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsVisible}"
                                                      IsVisible="{Binding !IsGroupHeader}" MinWidth="0"
                                                      ToolTip.Tip="Show on the canvas" AutomationProperties.Name="Visible" />
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}"
                                                      IsVisible="{Binding !IsGroupHeader}" MinWidth="0"
                                                      ToolTip.Tip="Lock position" AutomationProperties.Name="Locked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Data">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="12">
                    <StackPanel Spacing="4">
                        <DockPanel>
                            <TextBlock Text="Fields" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Manage..." Padding="8,2" FontSize="11"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="Import a field list, or remove one you no longer use">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="6" Width="300">
                                            <TextBlock Text="Field catalogs" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                                       Text="A catalog is the list of fields the system that fills your markers can provide. Import the list it exports and give it your own name for this kind of label. Import a script beside it and its functions can be completed too." />
                                            <TextBlock Text="Name (optional; the file name is used if blank)"
                                                       FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding NewCatalogName}"
                                                     PlaceholderText="Etiqueta externa (caixaria)" />
                                            <Button Content="Import a field list or script..."
                                                    Click="OnImportFieldCatalog"
                                                    HorizontalAlignment="Stretch" />
                                            <Rectangle Height="1" Fill="{DynamicResource AppSeparator}"
                                                       IsVisible="{Binding HasFieldCatalogs}" />
                                            <ItemsControl ItemsSource="{Binding FieldCatalogs}"
                                                          IsVisible="{Binding HasFieldCatalogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:FieldCatalogEntryViewModel">
                                                        <DockPanel Margin="0,2">
                                                            <Button DockPanel.Dock="Right" Content="Remove"
                                                                    FontSize="11" Padding="6,2"
                                                                    Command="{Binding RemoveCommand}" />
                                                            <TextBlock Text="{Binding Display}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding CatalogChoices}"
                                  SelectedItem="{Binding SelectedFieldCatalog}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="No catalog"
                                  ToolTip.Tip="The fields this label can use. Picking one turns on completion in the text and data boxes and flags markers the catalog does not list." />
                        <TextBlock Text="{Binding UnknownFieldWarning}"
                                   IsVisible="{Binding UnknownFieldWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#D97706" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasVariables}" Spacing="4" Margin="0,10,0,0">
                        <Rectangle Height="1" Fill="{DynamicResource AppSeparator}" />
                        <TextBlock Text="Variables" FontWeight="SemiBold" />
                        <TextBlock Text="The ##markers## on this label. One filled at print keeps its marker in the exported and printed ZPL; counters and dates are filled in for you."
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
                        <TextBlock Text="{Binding VariableWarning}"
                                   IsVisible="{Binding VariableWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#D97706" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Variables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VariableSampleViewModel">
                                    <Expander HorizontalAlignment="Stretch" Margin="0,4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PreviewValue}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Spacing="6">
                                        <ComboBox ItemsSource="{Binding Kinds}"
                                                  SelectedItem="{Binding SelectedKind}"
                                                  HorizontalAlignment="Stretch" />

                                        <TextBox IsVisible="{Binding IsExternal}"
                                                 Text="{Binding Sample}"
                                                 PlaceholderText="{Binding DefaultHint}"
                                                 ToolTip.Tip="Preview value only; the marker itself is what gets printed" />

                                        <StackPanel IsVisible="{Binding IsCounter}" Spacing="2">
                                            <TextBlock Classes="propLabel" Text="Start" />
                                            <NumericUpDown Value="{Binding CounterStart}"
                                                           Minimum="0" Maximum="999999999999"
                                                           Increment="1" FormatString="0" />
                                            <TextBlock Classes="propLabel" Text="Step (negative counts down)" />
                                            <NumericUpDown Value="{Binding CounterStep}"
                                                           Minimum="-999999" Maximum="999999"
                                                           Increment="1" FormatString="0" />
                                            <TextBlock Classes="propLabel" Text="Digits (0 = no padding)" />
                                            <NumericUpDown Value="{Binding CounterPadding}"
                                                           Minimum="0" Maximum="12"
                                                           Increment="1" FormatString="0" />
                                            <CheckBox Content="Let the printer count (^SN)" FontSize="12"
                                                      IsChecked="{Binding UsePrinterCounter}"
                                                      ToolTip.Tip="Sends one job and lets the printer serialize the run, which is much faster for long runs" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding IsClock}" Spacing="2">
                                            <TextBlock Classes="propLabel" Text="Format" />
                                            <ComboBox ItemsSource="{Binding ClockFormats}"
                                                      SelectedItem="{Binding SelectedClockPreset}"
                                                      PlaceholderText="Pick a format"
                                                      HorizontalAlignment="Stretch" />
                                            <TextBox Text="{Binding ClockFormat}"
                                                     PlaceholderText="dd/MM/yyyy"
                                                     ToolTip.Tip="Date format: dd, MM, yyyy, yy, HH, mm, ss" />
                                            <CheckBox Content="Use the printer's clock (^FC)" FontSize="12"
                                                      IsChecked="{Binding UsePrinterClock}"
                                                      ToolTip.Tip="Requires the real time clock option on the printer" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding PreviewValue}"
                                                   IsVisible="{Binding PreviewValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontFamily="Consolas,Menlo,Monospace" FontSize="11"
                                                   Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding KindHint}"
                                                   IsVisible="{Binding KindHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                                <TextBlock Text="This label has no variables." IsVisible="{Binding !HasVariables}" TextWrapping="Wrap" Opacity="0.65" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        </Grid>
        <Grid Grid.Row="5" RowDefinitions="Auto,Auto">
        <!-- Generated ZPL -->
        <Expander Name="ZplPanel" Grid.Row="0" Header="Generated ZPL" IsExpanded="False">
            <TextBox Name="ZplText" Text="{Binding GeneratedZpl}" IsReadOnly="True"
                     FontFamily="Consolas,Menlo,Monospace" FontSize="12"
                     Height="140" TextWrapping="NoWrap" />
        </Expander>

        <Border Grid.Row="1" Background="{DynamicResource AppPanelBackground}" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding WorkspaceStatus}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" FontSize="12" ToolTip.Tip="{Binding WorkspaceStatus}" />
                <Button Grid.Column="1" Content="Details" IsVisible="{Binding HasWorkspaceMessages}" Padding="8,2">
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <ScrollViewer MaxHeight="220" Width="360" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding WorkspaceMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
