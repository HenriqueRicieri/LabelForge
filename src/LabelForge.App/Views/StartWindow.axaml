<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelForge.App.ViewModels"
        x:Class="LabelForge.App.Views.StartWindow"
        x:DataType="vm:StartScreenViewModel"
        Title="LabelForge"
        Width="900" Height="600"
        CanMinimize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppPanelBackground}">

    <DockPanel Margin="20,16,20,14">
        <TextBlock DockPanel.Dock="Top" Text="Start" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <CheckBox Name="ShowAtStartupInput" Content="Show this at startup"
                      IsChecked="{Binding ShowAtStartup, Mode=TwoWay}" VerticalAlignment="Center"
                      ToolTip.Tip="Reopen it any time from File &gt; Start Screen" />
            <Button Grid.Column="1" Name="CloseStartButton" Content="Close" Click="OnClose" IsCancel="True" MinWidth="88"
                    HorizontalContentAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="250,24,*">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                <Button Name="NewBlankButton" Classes="accent" Content="New blank label" IsDefault="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,8"
                        Click="OnBlank" />
                <Button Grid.Row="1" Name="OpenLabelButton" Content="Open label..." Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,8"
                        Click="OnOpen" />
                <TextBlock Grid.Row="2" Text="Recent" FontWeight="SemiBold" Margin="0,20,0,6" />
                <TextBlock Grid.Row="3" Text="No recent labels yet." Opacity="0.6" FontSize="12"
                           IsVisible="{Binding !HasRecent}" />
                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="RecentList" ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RecentLabel">
                                <Button Classes="recent" Click="OnRecent" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Background="Transparent"
                                        Padding="8,5" Margin="0,0,0,2" ToolTip.Tip="{Binding Path}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Start from a sample" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Gallery.DensityText}" Opacity="0.6" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="StarterList" ItemsSource="{Binding Gallery.Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:StarterCardViewModel">
                                <Button Click="OnStarter" Width="186" Margin="0,0,8,8" Padding="6"
                                        HorizontalContentAlignment="Stretch" Background="Transparent"
                                        ToolTip.Tip="{Binding Summary}">
                                    <StackPanel>
                                        <!-- White behind the label whatever the theme, as in the gallery. -->
                                        <Border Background="White" CornerRadius="3" Height="120"
                                                BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1" Padding="6">
                                            <Image Source="{Binding Preview}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" Opacity="0.6" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
