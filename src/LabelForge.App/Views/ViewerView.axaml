<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelForge.App.ViewModels"
        xmlns:aedit="using:AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="720"
        x:Class="LabelForge.App.Views.ViewerView"
        x:DataType="vm:ViewerViewModel">

    <UserControl.Styles>
        <Style Selector="Border.statusPill">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.statusPill.error">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Border.statusPill TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Label setup -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource AppToolbarBackground}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Open..." Click="OnOpenFile" ToolTip.Tip="Open a .zpl file (Ctrl+O)" />
                <Rectangle Width="1" Height="22" Fill="{DynamicResource AppSeparator}" />
                <CheckBox Content="Auto size" IsChecked="{Binding AutoSize}"
                          ToolTip.Tip="Read the label size from ^PW / ^LL in the ZPL" />
                <TextBlock Text="Width (mm)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding WidthMm}" Minimum="5" Maximum="600"
                               Increment="1" FormatString="0.#" Width="110"
                               IsEnabled="{Binding !AutoSize}" />
                <TextBlock Text="Height (mm)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding HeightMm}" Minimum="5" Maximum="1000"
                               Increment="1" FormatString="0.#" Width="110"
                               IsEnabled="{Binding !AutoSize}" />
                <TextBlock Text="Density" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Densities}"
                          SelectedItem="{Binding SelectedDensity}" Width="100" />
                <Button Content="Print..." ToolTip.Tip="Send to a network printer (sample data is substituted, matching the preview)">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" Width="230">
                                <TextBlock Text="Printer address (TCP 9100)" FontSize="12" Opacity="0.8" />
                                <TextBox Text="{Binding PrinterHost}" PlaceholderText="192.168.0.50" />
                                <TextBlock Text="Port" FontSize="12" Opacity="0.8" />
                                <NumericUpDown Value="{Binding PrinterPort}" Minimum="1" Maximum="65535"
                                               Increment="1" FormatString="0" />
                                <Button Content="Send to printer" Command="{Binding PrintCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>
        </Border>

        <!-- Diagnostics strip -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="{DynamicResource AppToolbarBackground}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Classes="statusPill" Classes.error="{Binding HasErrors}">
                    <TextBlock Text="{Binding ErrorText}" />
                </Border>
                <TextBlock Text="{Binding InfoText}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EncodingNote}" VerticalAlignment="Center"
                           IsVisible="{Binding EncodingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#D97706" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ComparisonSummary}" VerticalAlignment="Center"
                           IsVisible="{Binding HasComparison}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Editor | Preview -->
        <Grid ColumnDefinitions="*,4,1.4*">
            <aedit:TextEditor Grid.Column="0"
                              Name="ZplEditor"
                              FontFamily="Consolas,Menlo,Monospace" FontSize="13"
                              ShowLineNumbers="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" />

            <GridSplitter Grid.Column="1" Background="{DynamicResource AppSeparator}" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*">

                <!-- Preview toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="6,6,6,4">
                    <Button Content="Fit" Click="OnFit" ToolTip.Tip="Fit to window (Ctrl+9)" />
                    <Button Content="100%" Click="OnActual" ToolTip.Tip="Actual size (Ctrl+0)" />
                    <Button Content="&#8722;" Click="OnZoomOut" ToolTip.Tip="Zoom out (Ctrl+-)" Width="34" />
                    <Button Content="+" Click="OnZoomIn" ToolTip.Tip="Zoom in (Ctrl++)" Width="34" />
                    <TextBlock Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                               MinWidth="46" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding LabelOptions}"
                              SelectedIndex="{Binding SelectedLabelIndex}"
                              IsVisible="{Binding HasMultipleLabels}"
                              MinWidth="100"
                              ToolTip.Tip="This file has several labels; pick one" />

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource AppSeparator}" />

                    <!-- Compare mode is a button with a flyout, not a toggle, and that is
                         deliberate: a live comparison would put the label on the wire on
                         every keystroke. Each press is one send the user asked for, with
                         what leaves the machine written above the button they press. -->
                    <Button Content="Compare..." IsEnabled="{Binding !IsComparing}"
                            ToolTip.Tip="Render the same ZPL at Labelary and compare (sends the label over the internet)">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Width="290">
                                    <TextBlock Text="Compare with Labelary" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OutboundDescription}"
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#D97706"
                                               Text="Labelary renders what a printer prints, so it is the reference when the offline preview and it disagree." />
                                    <Button Content="Send and compare" Command="{Binding CompareCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="Close compare" Command="{Binding ClearComparisonCommand}"
                            IsVisible="{Binding HasComparison}" />

                    <TextBlock Text="Comparing..." VerticalAlignment="Center" Opacity="0.7"
                               IsVisible="{Binding IsComparing}" />
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource AppPreviewSurface}">
                    <ScrollViewer Name="PreviewScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PointerWheelChanged="OnPreviewWheel">
                        <LayoutTransformControl Name="PreviewTransform"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <!-- Side by side once a comparison exists, and the offline
                                 render keeps its place on the left so the eye does not
                                 have to work out which is which. Both sit inside the one
                                 zoom transform, or comparing them would mean matching two
                                 zoom levels by hand. -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Offline (this app)" FontSize="11" Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding HasComparison}" />
                                    <Image Name="PreviewImageControl"
                                           Source="{Binding PreviewImage}" Stretch="None" />
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding HasComparison}">
                                    <TextBlock Text="Labelary" FontSize="11" Opacity="0.7"
                                               HorizontalAlignment="Center" />
                                    <Image Source="{Binding ComparisonImage}" Stretch="None" />
                                </StackPanel>
                            </StackPanel>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>

</UserControl>
