<Project Sdk="Microsoft.NET.Sdk">
  <!-- Render benchmark. Prints the per-frame cost of everything the designer's render
       pass does, as markdown tables meant to be pasted into docs/PLAN.md beside the
       change they justify. Not on the test path and not in CI: it is run deliberately,
       on a Release build, and compared against the previous run on the same machine.
       Run it from tools/LabelForge.Bench with "dotnet run -c Release". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reflection-based JSON, matching how the app serializes a document. Without it
         the undo/recovery row measures a trimmed-away serializer instead. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LabelForge.Core\LabelForge.Core.csproj" />
  </ItemGroup>
</Project>
